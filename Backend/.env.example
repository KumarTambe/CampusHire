# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/campushire

# Secret used to sign JWTs — use a long random string in production
JWT_SECRET=change-me-to-a-long-random-string

# Port the API listens on (Render sets this automatically)
PORT=3000

# Comma separated list of allowed frontend origins.
# Leave blank in local development to allow any origin.
CLIENT_URL=http://localhost:5173
